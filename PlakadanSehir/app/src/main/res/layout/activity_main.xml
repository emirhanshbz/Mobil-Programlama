<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/anaSayfaLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="top|center_horizontal">

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp" />

    
    <TextView
        android:id="@+id/textSure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Geçen Süre: 0 saniye"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBaslat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Başla" />

    <SeekBar
        android:id="@+id/plakaSecici"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="80"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/textPlaka"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seçilen plaka: 1"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#444444"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/sehirGirisi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Şehir adı yaz"
        android:inputType="text"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnOnayla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Onayla"
        android:layout_marginTop="20dp" />

</LinearLayout>
